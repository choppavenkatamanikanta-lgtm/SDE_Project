{
  "name": "shared-home-bill-splitter",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --dir api dev",
    "dev:web": "pnpm --dir web dev",
    "build": "pnpm --dir web build",
    "typecheck": "pnpm --dir api typecheck && pnpm --dir web typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
